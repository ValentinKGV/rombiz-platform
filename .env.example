# ═══════════════════════════════════════════════════════════════════
#  RomBiz Intelligence Platform — Environment Configuration
#  Copy to .env and fill in the values for your environment
# ═══════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
APP_NAME="RomBiz Intelligence"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database ─────────────────────────────────────────────────────
# SQLite (development — no extra setup needed):
DATABASE_URL=sqlite+aiosqlite:///./rombiz_dev.db
# PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql+asyncpg://rombiz:changeme@postgres:5432/rombiz
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
# Docker-compose Postgres password:
POSTGRES_PASSWORD=changeme

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ── Celery ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Elasticsearch ────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=rombiz

# ── Neo4j (Fraud Graph) ─────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── MinIO / S3 ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_PDFS=pdfs
MINIO_SECURE=false
# Docker-compose MinIO root credentials:
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── JWT Authentication ──────────────────────────────────────────
# RS256 (production) — generate keys:
#   openssl genpkey -algorithm RSA -out keys/private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in keys/private.pem -out keys/public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# For development without key files, set JWT_ALGORITHM=HS256 (auto-fallback)

# ── GDPR ─────────────────────────────────────────────────────────
# CNP_PEPPER — auto-generated if not set; fix a value for data persistence
# CNP_PEPPER=CHANGE_THIS_TO_A_RANDOM_HEX_STRING_64_CHARS
AUDIT_LOG_RETENTION_DAYS=90
IP_ANONYMIZE_AFTER_DAYS=30

# ── External APIs ───────────────────────────────────────────────
ANAF_WEBSERVICE_URL=https://webservicesp.anaf.ro/PlatitorTvaRest/api/v8/ws/tva
ANAF_STATIC_BASE_URL=https://static.anaf.ro/static/10/Anaf/informatii_R/
ANAF_BATCH_SIZE=500
ANAF_RATE_LIMIT_RPS=8

BNR_DAILY_URL=https://www.bnr.ro/nbrfxrates.xml
BNR_HISTORIC_URL=https://www.bnr.ro/files/xml/years/nbrfxrates{year}.xml

BPI_RSS_URL=https://www.buletinul.ro/rss/

MO_RSS_MO4=https://www.monitoruloficial.ro/rss/mo4.xml
MO_RSS_MO7=https://www.monitoruloficial.ro/rss/mo7.xml

SEAP_API_URL=https://sicap-prod.e-licitatie.ro/api/

ONRC_RECOM_URL=https://recom.onrc.ro/
ONRC_CACHE_TTL_DAYS=30
ONRC_RATE_LIMIT_RPS=1.0

# ── AI Agent ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-20250514

# ── Email / SMS ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_API_KEY=

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Frontend ─────────────────────────────────────────────────────
VITE_API_URL=http://localhost:80

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_DEFAULT_RPM=60

# ── Sentry (Error Tracking, optional) ───────────────────────────
SENTRY_DSN=
