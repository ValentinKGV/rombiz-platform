# ═══════════════════════════════════════════════════════════════════
#  RomBiz Intelligence Platform — Environment Configuration
#  Copy this file to .env and adjust values for your environment.
# ═══════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
APP_NAME="RomBiz Intelligence"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production
BASE_URL=https://your-domain.example.com
ALLOWED_ORIGINS=["https://your-domain.example.com"]

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rombiz_user:CHANGE_ME@localhost:5432/rombiz_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ── Celery ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Elasticsearch ────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=rombiz

# ── Neo4j ────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── MinIO ────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_PDFS=pdfs
MINIO_SECURE=false

# ── JWT Authentication ──────────────────────────────────────────
# Generate keys: openssl genrsa -out keys/private.pem 4096
#                openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── GDPR ─────────────────────────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=90
IP_ANONYMIZE_AFTER_DAYS=30

# ── External APIs ───────────────────────────────────────────────
ANAF_WEBSERVICE_URL=https://webservicesp.anaf.ro/PlatitorTvaRest/api/v8/ws/tva
ANAF_STATIC_BASE_URL=https://static.anaf.ro/static/10/Anaf/informatii_R/
ANAF_BATCH_SIZE=500
ANAF_RATE_LIMIT_RPS=8

BNR_DAILY_URL=https://www.bnr.ro/nbrfxrates.xml
BNR_HISTORIC_URL=https://www.bnr.ro/files/xml/years/nbrfxrates{year}.xml

BPI_RSS_URL=https://www.buletinul.ro/rss/
MO_RSS_MO4=https://www.monitoruloficial.ro/rss/mo4.xml
MO_RSS_MO7=https://www.monitoruloficial.ro/rss/mo7.xml

SEAP_API_URL=https://sicap-prod.e-licitatie.ro/api/
ONRC_RECOM_URL=https://recom.onrc.ro/
ONRC_CACHE_TTL_DAYS=30
ONRC_RATE_LIMIT_RPS=1.0

# ── AI Agent ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-20250514

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_DEFAULT_RPM=60
